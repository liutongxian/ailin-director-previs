{
  "name": "ailin-director-previs",
  "version": "0.2.0",
  "description": "艾琳导演台开源核心：可编辑搭景、镜头调度及 Three.js / Blender 白模预演视频。",
  "main": "out/main/index.js",
  "author": "Tongxian",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/electron-vite/bin/electron-vite.js dev",
    "start": "node ./node_modules/electron-vite/bin/electron-vite.js preview",
    "build": "node ./node_modules/electron-vite/bin/electron-vite.js build",
    "package:win": "npm run build && electron-builder --win portable --x64 --config electron-builder.yml --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && playwright test tests/e2e/smoke.spec.ts tests/e2e/director-package-flow.spec.ts",
    "e2e": "npm run build && playwright test",
    "ailin": "node mcp/ailin-cli.mjs"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "three": "^0.170.0",
    "unzipper": "^0.12.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^9.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
